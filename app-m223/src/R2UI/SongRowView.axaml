<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HuayuanPreview.R2.SongRowView" xmlns:vm="using:HuayuanPreview.R2" xmlns:tok="using:HuayuanPreview" x:DataType="vm:TrackRow" x:CompileBindings="True" Height="{x:Static tok:DesignTokens.SongRowHeight}">
  <Border Classes="song-row" Classes.song-current="{Binding IsCurrent}" Classes.unavailable="{Binding IsUnavailable}" ToolTip.Tip="{Binding UnavailableReason}">
  <Grid ColumnDefinitions="33,46,3*,1.25*,1.20*,68,56" ColumnSpacing="7" Margin="7,0">
    <Border Width="18" Height="18" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="{Binding IsBatchMode}" BorderThickness="1.5"
            BorderBrush="{DynamicResource R2Muted}" Background="Transparent">
      <PathIcon Width="12" Height="12" IsVisible="{Binding IsSelected}" Data="M2 8L6 12L14 4L15.5 5.5L6 15L0.5 9.5Z" Foreground="{DynamicResource R2RedInk}"/>
    </Border>
    <TextBlock Text="{Binding Number}" FontFeatures="tnum" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsNumberVisible}"/>
    <vm:PlaybackWave Fill="{DynamicResource R2RedInk}" IsPlaying="{Binding IsPlaying}" IsVisible="{Binding IsWaveVisible}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <vm:TrackArtwork Grid.Column="1" DisplaySize="{x:Static tok:DesignTokens.SongRowCover}" VerticalAlignment="Center"/>
    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
        <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" Classes.current="{Binding IsCurrent}" FontSize="{x:Static tok:DesignTokens.FontMd}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="无损 FLAC" FontSize="10" Classes="muted" IsVisible="{Binding IsLosslessFile}" VerticalAlignment="Center"/>
          <PathIcon Width="12" Height="12" IsVisible="{Binding IsDownloaded}" ToolTip.Tip="已下载" Foreground="{DynamicResource R2Muted}" Data="M2 8L6 12L14 4L15.5 5.5L6 15L.5 9.5Z"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Classes="row-actions" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" IsVisible="{Binding CanUsePlatform}">
        <Button Classes="icon" Padding="0" Width="28" Height="30" Click="PlayInline" AutomationProperties.Name="{Binding PlayLabel}" ToolTip.Tip="播放">
          <PathIcon Width="13" Height="13" Data="M4,2 L16,9 L4,16 Z"/>
        </Button>
        <vm:HeartButton IsVisible="{Binding !CanUseOnlineActions}"/>
        <Button Classes="icon" Padding="0" Width="28" Height="30" Command="{Binding NextCommand}" AutomationProperties.Name="下一首播放" ToolTip.Tip="安排下一首">
          <PathIcon Width="15" Height="15" Data="M2,4 H13 V6 H2 Z M2,9 H9 V11 H2 Z M2,14 H9 V16 H2 Z M11,9 L18,13 L11,17 Z"/>
        </Button>
        <Button Classes="icon" Width="28" Height="28" Padding="0" IsVisible="{Binding CanUseOnlineActions}" Click="CommentInline" AutomationProperties.Name="查看评论" ToolTip.Tip="查看评论"><PathIcon Width="15" Height="15" Data="M1 2H15V12H8L4 16V12H1Z M3 4V10H6V12L8 10H13V4Z M5 6H11V8H5Z"/></Button>
        <Button Classes="icon" Width="28" Height="28" Padding="0" IsVisible="{Binding CanRemoveLocally}" Command="{Binding RemoveLocalCommand}" AutomationProperties.Name="{Binding RemoveLocalLabel}" ToolTip.Tip="{Binding RemoveLocalLabel}"><PathIcon Width="14" Height="14" Data="M3 6H17V18H3V6ZM5 8V16H15V8H5ZM7 2H13V4H7V2ZM9 10H11V14H9V10Z"/></Button>
      </StackPanel>
      <Button Grid.Column="1" Content="查看" Command="{Binding InspectCommand}" IsVisible="{Binding CanInspectOffline}" AutomationProperties.Name="{Binding InspectLabel}"/>
    </Grid>
    <TextBlock Grid.Column="3" Text="{Binding Singer}" Classes="muted" FontSize="{x:Static tok:DesignTokens.FontXs}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="4" Text="{Binding AlbumName}" Classes="muted" FontSize="{x:Static tok:DesignTokens.FontXs}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <StackPanel Name="OnlineRowActions" Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                IsVisible="{Binding CanUseOnlineActions}">
      <vm:HeartButton/>
      <vm:SongDownloadButton/>
    </StackPanel>
    <TextBlock Grid.Column="6" Text="{Binding Duration}" Classes="muted" FontFeatures="tnum" VerticalAlignment="Center"/>
  </Grid>
  </Border>
</UserControl>
