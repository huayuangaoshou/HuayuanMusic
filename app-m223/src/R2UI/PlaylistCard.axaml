<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HuayuanPreview.R2.PlaylistCard" xmlns:vm="using:HuayuanPreview.R2" x:DataType="vm:PlaylistCardModel" x:CompileBindings="True" Margin="0,0,12,12"><Button Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="White" BorderThickness="1" BorderBrush="#E2E8F1" Padding="12" AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="{Binding AutomationId}"><Grid RowDefinitions="56,Auto,Auto"><ContentControl Content="{Binding Cover}" HorizontalAlignment="Left"/><TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" Margin="0,8,0,3" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11" Foreground="#788599" TextTrimming="CharacterEllipsis"/></Grid></Button></UserControl>
