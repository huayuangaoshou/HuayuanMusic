<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HuayuanPreview.R2.PlaylistCard" xmlns:vm="using:HuayuanPreview.R2" x:DataType="vm:PlaylistCardModel" x:CompileBindings="True" Margin="0,4,16,15">
  <Border Classes="playlist-tile">
    <Grid RowDefinitions="172,Auto,Auto" Width="172">
      <Button Padding="0" Background="Transparent" CornerRadius="12" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="{Binding AutomationId}">
        <ContentControl Content="{Binding Cover}" HorizontalAlignment="Center"/>
      </Button>
      <Button Classes="primary card-play" Width="38" Height="38" Margin="0,0,9,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="▶" Command="{Binding PlayCommand}" IsVisible="{Binding CanPlay}" AutomationProperties.Name="播放歌单"/>
      <Button Grid.Row="1" Command="{Binding OpenCommand}" Content="{Binding Title}" FontSize="14" FontWeight="SemiBold" Padding="1,8,1,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      <TextBlock Grid.Row="2" Text="{Binding Description}" Classes="muted" FontSize="11" Margin="2,2,0,2" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</UserControl>
