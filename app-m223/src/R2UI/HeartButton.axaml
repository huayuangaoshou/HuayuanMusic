<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r2="using:HuayuanPreview.R2" x:Class="HuayuanPreview.R2.HeartButton"
             x:DataType="r2:TrackRow" x:CompileBindings="True" Width="30" Height="30">
  <Button Classes="heart" Classes.liked="{Binding IsFavorite}" Command="{Binding FavoriteCommand}"
          Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="7"
          ToolTip.Tip="{Binding FavoriteLabel}" AutomationProperties.Name="{Binding FavoriteLabel}">
    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource R2Heart}"
          StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round"/>
  </Button>
</UserControl>
