<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:HuayuanPreview" x:Class="HuayuanPreview.R2.R2ShellView" x:CompileBindings="False">
<UserControl.Resources><Color x:Key="SukiAccentColor75">#547AC5</Color><Color x:Key="SukiStrongBackground">#FAFBFD</Color><Color x:Key="SukiPrimaryColor5">#547AC5</Color><Color x:Key="SukiPrimaryColor3">#EAF1FC</Color><Color x:Key="SukiPrimaryColor1">#F2F6FC</Color><Color x:Key="SukiText">#344157</Color><Color x:Key="SukiLowText">#798599</Color></UserControl.Resources>
<UserControl.Styles><StyleInclude Source="avares://HuayuanMusic.P17.Nightflight/R2UI/VisualDensity.axaml" /></UserControl.Styles>
<LayoutTransformControl Name="UiScaleHost"><Grid RowDefinitions="Auto,*,Auto" Background="White">
<StackPanel Background="#F3F5F8" Margin="0" Spacing="4"><WrapPanel Margin="8"><Button Content="本地音乐" Command="{Binding SwitchLocalCommand}" AutomationProperties.Name="切换本地工作空间"/><Button Content="酷狗概念版" Command="{Binding SwitchKugouCommand}" AutomationProperties.Name="切换概念版工作空间"/></WrapPanel><TextBlock Name="EnvironmentNotice" Margin="10,0,8,8" Text="离线预览 · 本地隔离曲库 · 酷狗合成歌单与音频" FontSize="11" TextWrapping="Wrap"/></StackPanel>
<ContentControl Grid.Row="1" Content="{Binding WorkspaceRoot}" ClipToBounds="True"/>
<Border Grid.Row="2" BorderBrush="#D8DDE5" BorderThickness="0,1,0,0" Background="#F3F5F8" Padding="10"><Grid Name="FooterGrid" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,*"><StackPanel><TextBlock Text="{Binding Player.DisplayedPlayingSong.Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceLabel}" FontSize="11"/><TextBlock Text="{Binding Player.TransportStatus}" FontSize="11"/><TextBlock Text="{Binding Player.ProgressText}" FontSize="11" AutomationProperties.AutomationId="M223.Progress"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="上一首" Command="{Binding Player.PlayPreviousCommand}" AutomationProperties.Name="上一首"/><Button Content="播放 / 暂停" Command="{Binding Player.TogglePlayPauseCommand}" AutomationProperties.Name="播放或暂停"/><Button Content="下一首" Command="{Binding Player.PlayNextCommand}" AutomationProperties.Name="下一首"/><Button Content="停止" Command="{Binding Player.StopCommand}" AutomationProperties.Name="停止播放"/></WrapPanel><TextBlock Grid.Column="2" Text="{Binding Player.PlaybackFeedback}" TextWrapping="Wrap" MaxWidth="230" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#738097" FontSize="11"/>
<TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Player.ActiveLyric}" TextAlignment="Center"
           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="M223.Lyric"/>
<local:CommitSlider Grid.Row="2" Grid.ColumnSpan="3" Name="DesktopProgress" AutomationProperties.Name="播放进度" IsVisible="False"/>
</Grid></Border>
</Grid></LayoutTransformControl></UserControl>