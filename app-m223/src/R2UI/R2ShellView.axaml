<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lyrics="using:AvaloniaLyrics" xmlns:local="using:HuayuanPreview" xmlns:r2="using:HuayuanPreview.R2"
             xmlns:tok="using:HuayuanPreview"
             x:Class="HuayuanPreview.R2.R2ShellView" x:CompileBindings="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaLyrics/Themes/AvaloniaLyrics.axaml"/>
  </UserControl.Styles>
  <Grid Name="Root" RowDefinitions="*" ColumnDefinitions="224,*" Background="{DynamicResource GlassBase}">
    <Border Name="CoverTint" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource GlassBase}" IsHitTestVisible="False">
      <Border.Transitions><Transitions><BrushTransition Property="Background" Duration="0:0:0.4" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
    </Border>
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource GlassPinkGlow}" IsHitTestVisible="False"/>
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource GlassBlueGlow}" IsHitTestVisible="False"/>
    <r2:GlassOptics Grid.RowSpan="2" Grid.ColumnSpan="2" IsAtmosphere="True" IsHitTestVisible="False"/>
    <Border Classes="glass glass-side" Background="{DynamicResource GlassSide}" Margin="12,12,0,96">
      <Grid>
      <r2:GlassOptics Radius="12" Frost="{x:Static tok:DesignTokens.FrostChrome}" Saturation="{x:Static tok:DesignTokens.SaturationChrome}" Margin="1" IsHitTestVisible="False"/>
      <Grid RowDefinitions="64,Auto,*,Auto" Margin="13,0">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="8,0">
          <Image Width="32" Height="32" Source="avares://HuayuanMusic.P17.Nightflight/Assets/icon-1024.png" />
          <TextBlock Text="HuayuanMusic" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,2,0,12">
          <TextBlock Text="工作空间" Classes="muted" FontSize="12" Margin="10,2,0,4"/>
          <Button Classes="nav" Classes.selected="{Binding Workspace.IsLocalFallbackSelected}" Command="{Binding SwitchLocalCommand}" AutomationProperties.Name="切换本地工作空间">本地音乐</Button>
          <Button Classes="nav" Classes.selected="{Binding Workspace.IsKugouFallbackSelected}" IsVisible="{Binding KugouEnabled}" Command="{Binding SwitchKugouCommand}" AutomationProperties.Name="切换概念版工作空间">酷狗概念版</Button>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding Workspace.Navigation}"/>
        </ScrollViewer>
        <Border Grid.Row="3" Name="SidebarFooter" BorderBrush="{DynamicResource R2Edge}" BorderThickness="0,1,0,0" Padding="0,12">
          <StackPanel>
            <Button Classes="nav" Click="OpenSettings">设置</Button>
            <Button Classes="nav" Click="OpenPluginCenter">平台管理</Button>
          </StackPanel>
        </Border>
      </Grid>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="64,*">
      <Border>
        <Grid Name="Toolbar" ColumnDefinitions="Auto,Auto,240,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="16,0,8,0">
          <Button Classes="icon" Width="32" Height="32" ToolTip.Tip="后退" AutomationProperties.Name="后退" Click="GoBack" VerticalAlignment="Center"><PathIcon Width="16" Height="16" Data="{DynamicResource GlassBack}"/></Button>
          <Button Grid.Column="1" Classes="icon" Width="32" Height="32" ToolTip.Tip="前进" AutomationProperties.Name="前进" Click="GoForward" VerticalAlignment="Center"><PathIcon Width="16" Height="16" Data="{DynamicResource GlassForward}"/></Button>
          <TextBox Grid.Column="2" Name="CurrentFilter" Classes="search-capsule" MaxLength="120" PlaceholderText="筛选本地音乐" VerticalAlignment="Center" TextChanged="FilterChanged"/>
          <Popup Grid.Column="2" Name="SuggestionsPopup" PlacementTarget="{Binding #CurrentFilter}" Placement="BottomEdgeAlignedLeft" VerticalOffset="5"
                 ShouldUseOverlayLayer="False" TakesFocusFromNativeControl="False" OverlayDismissEventPassThrough="True" IsLightDismissEnabled="True">
            <Border Classes="glass glass-float" Background="{DynamicResource GlassPopup}" Width="296">
              <Grid>
              <r2:GlassOptics Radius="12" Frost="{x:Static tok:DesignTokens.FrostFloating}" Saturation="{x:Static tok:DesignTokens.SaturationFloating}" Margin="1" IsHitTestVisible="False"/>
              <StackPanel Margin="10" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Name="SuggestionTitle" Classes="muted" Margin="8,4" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Name="ClearHistory" Content="清除" Click="ClearRecentSearches" IsVisible="False"/>
                </Grid>
                <WrapPanel Name="HistoryChips" IsVisible="False"/>
                <ListBox Name="SuggestionList" MaxHeight="385" Background="Transparent" AutomationProperties.Name="酷狗搜索联想"/>
              </StackPanel>
              </Grid>
            </Border>
          </Popup>
          <Border Grid.Column="3" Name="DragArea" Background="Transparent" PointerPressed="StartWindowDrag" DoubleTapped="ToggleWindowSize"/>
          <Button Grid.Column="4" Name="AccountButton" IsVisible="{Binding KugouEnabled}" Click="ShowAccount" VerticalAlignment="Center" AutomationProperties.Name="我的账号">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ContentControl Content="{Binding AccountAvatar}" Width="24" Height="24" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding AccountLabel}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="5" Classes="caption" FontSize="18" ToolTip.Tip="切换浅色或深色" AutomationProperties.Name="切换主题" Click="ToggleTheme" VerticalAlignment="Center"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassMoon}"/></Button>
          <Button Grid.Column="6" Classes="caption" ToolTip.Tip="最小化" AutomationProperties.Name="最小化窗口" Click="MinimizeWindow" VerticalAlignment="Center"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassMinimize}"/></Button>
          <Button Grid.Column="7" Classes="caption" Name="MaximizeButton" ToolTip.Tip="最大化或还原" AutomationProperties.Name="最大化或还原" Click="ToggleWindowSize" VerticalAlignment="Center"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassMaximize}"/></Button>
          <Button Grid.Column="8" Classes="caption close" FontSize="18" ToolTip.Tip="关闭" AutomationProperties.Name="关闭窗口" Click="CloseWindow" VerticalAlignment="Center"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassClose}"/></Button>
        </Grid>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding WorkspaceRoot}" ClipToBounds="True"/>

    </Grid>
    <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Name="LyricsOverlay" ZIndex="3" IsVisible="False" Opacity="0" Background="{DynamicResource FullLyricBack}">
      <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
      <Grid ClipToBounds="True">
        <Border Background="{DynamicResource FullLyricBack}"/>
        <Border Background="{DynamicResource GlassPinkGlow}"/>
        <Border Background="{DynamicResource GlassBlueGlow}"/>
        <r2:GlassOptics IsAtmosphere="True" IsHitTestVisible="False"/>
        <r2:TrackArtwork DisplaySize="420" IsHitTestVisible="False" Opacity="0.43" HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransform="scale(3.1)" DataContext="{Binding Player.DisplayedPlayingSong}">
          <r2:TrackArtwork.Effect><BlurEffect Radius="76"/></r2:TrackArtwork.Effect>
        </r2:TrackArtwork>
        <Border Background="{DynamicResource FullLyricVeil}"/>
        <Grid RowDefinitions="56,*" Margin="24,8,24,24">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
            <Button Classes="glass-pill" Width="40" Height="40" Padding="0" Click="HideLyricOverlay" AutomationProperties.Name="收起正在播放">
              <PathIcon Width="15" Height="15" Data="M2,5 L8,11 L14,5 L16,7 L8,15 L0,7 Z"/>
            </Button>
            <Border Grid.Column="1" Background="Transparent" PointerPressed="StartWindowDrag" DoubleTapped="ToggleWindowSize"/>
            <Button Grid.Column="2" Classes="caption" AutomationProperties.Name="切换歌词页主题" Click="ToggleTheme"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassMoon}"/></Button>
            <Button Grid.Column="3" Classes="caption" AutomationProperties.Name="最小化窗口" Click="MinimizeWindow"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassMinimize}"/></Button>
            <Button Grid.Column="4" Classes="caption" AutomationProperties.Name="最大化或还原" Click="ToggleWindowSize"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassMaximize}"/></Button>
            <Button Grid.Column="5" Classes="caption close" AutomationProperties.Name="关闭窗口" Click="CloseWindow"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassClose}"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="44*,56*" ColumnSpacing="32">
            <StackPanel Margin="12,0" MaxWidth="390" VerticalAlignment="Center" Spacing="8">
              <Border Classes="glass" HorizontalAlignment="Center" CornerRadius="12" Padding="1" BoxShadow="{DynamicResource GlassLift}">
                <r2:TrackArtwork DisplaySize="300" DataContext="{Binding Player.DisplayedPlayingSong}"/>
              </Border>
              <Border Padding="16,0" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="0" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <SelectableTextBlock Text="{Binding Player.NowPlayingTitle}" FontSize="18" FontWeight="Bold" MaxWidth="320" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource R2Ink}"/>
                    <Border IsVisible="{Binding Player.HasCurrentSong}"><r2:HeartButton DataContext="{Binding Player.DisplayedPlayingSong}"/></Border>
                    <r2:SongDownloadButton DataContext="{Binding Player.DisplayedPlayingSong}"/>
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Player.NowPlayingCredit}" Classes="muted" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="365" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="43,*,43" ColumnSpacing="8" Margin="0,4,0,0">
                <TextBlock Text="{Binding Player.PositionText}" Classes="muted" FontFeatures="tnum" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                <local:CommitSlider Grid.Column="1" Name="FullProgress" Classes="progress" AutomationProperties.Name="歌词页播放进度"/>
                <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" Classes="muted" FontFeatures="tnum" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Classes="glass-pill" Content="{Binding Player.ModeLabel}" Command="{Binding Player.CycleModeCommand}" AutomationProperties.Name="播放模式"/>
                <Button Classes="icon" Width="32" Height="32" Command="{Binding Player.PlayPreviousCommand}" ToolTip.Tip="上一首" AutomationProperties.Name="上一首"><PathIcon Width="16" Height="16" Data="M3,2 H5 V18 H3 Z M17,2 L6,10 L17,18 Z"/></Button>
                <Grid Width="53" Height="53">
                  <Button Classes="primary" Width="53" Height="53" Command="{Binding Player.TogglePlayPauseCommand}" ToolTip.Tip="播放或暂停" AutomationProperties.Name="播放或暂停">
                  <Grid Width="18" Height="18">
                    <PathIcon Foreground="White" Data="M4,2 L16,9 L4,16 Z" IsVisible="{Binding !Player.IsPlayingAudio}"/>
                    <PathIcon Foreground="White" Data="M4,2 H7 V16 H4 Z M11,2 H14 V16 H11 Z" IsVisible="{Binding Player.IsPlayingAudio}"/>
                  </Grid>
                </Button>
                  <Border Classes="buffer-ring" IsVisible="{Binding Player.IsBuffering}" IsHitTestVisible="False" Margin="-3" BorderThickness="1.5"
                          CornerRadius="999" BorderBrush="{DynamicResource R2BrandGradient}" AutomationProperties.Name="正在缓冲"/>
                </Grid>
                <Button Classes="icon" Width="32" Height="32" Command="{Binding Player.PlayNextCommand}" ToolTip.Tip="下一首" AutomationProperties.Name="下一首"><PathIcon Width="16" Height="16" Data="M3,2 L14,10 L3,18 Z M15,2 H17 V18 H15 Z"/></Button>
              </StackPanel>
              <Border Classes="glass" CornerRadius="999" HorizontalAlignment="Center" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Content="音量" Command="{Binding Player.MuteCommand}" ToolTip.Tip="静音或恢复音量"/>
                  <local:CommitSlider Name="FullVolume" Width="51" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="歌词页音量"/>
                  <ComboBox Name="FullQuality" Width="75" Background="{DynamicResource GlassSide}" Foreground="{DynamicResource R2Ink}"
                            BorderBrush="{DynamicResource GlassRim}" AutomationProperties.Name="歌词页音质" SelectionChanged="ChangeQuality">
                    <ComboBoxItem Content="标准"/><ComboBoxItem Content="高品 MP3"/><ComboBoxItem Content="无损 FLAC"/>
                  </ComboBox>
                  <Button Name="TranslationToggle" Classes="glass-pill" Content="译" Click="ToggleTranslation" AutomationProperties.Name="显示歌词翻译"/>
                  <Button Name="FullDesktopLyricToggle" Classes="glass-pill desktop-lyric" Content="词" Click="ToggleDesktopLyrics" AutomationProperties.Name="歌词页桌面歌词开关"/>
                  <Button Content="队列" Click="ToggleQueue" AutomationProperties.Name="歌词页播放队列"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <Grid Grid.Column="1" RowDefinitions="42,*">
              <Border Classes="glass" CornerRadius="999" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Name="LyricsTab" Classes="glass-pill selected" Content="歌词" Click="ShowLyricsTab"/>
                  <Button Name="CommentsTab" IsVisible="{Binding Player.DisplayedPlayingSong.IsProviderTrack}" Classes="glass-pill" Click="ShowCommentsTab" AutomationProperties.Name="歌曲评论">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="评论"/>
                      <Border Name="CommentBadge" IsVisible="False" Background="{DynamicResource R2Tint}" CornerRadius="999" Padding="6,1">
                        <TextBlock Name="CommentCount" FontSize="12" Foreground="{DynamicResource R2RedInk}"/>
                      </Border>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" Name="LyricsPane">
                <Grid.OpacityMask>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset=".11"/>
                    <GradientStop Color="Black" Offset=".89"/><GradientStop Color="Transparent" Offset="1"/>
                  </LinearGradientBrush>
                </Grid.OpacityMask>
                <lyrics:LyricView Name="FullLyricView" PrimaryFontSize="20" TranslationFontSize="15" ActiveAnchorRatio="0.44"
                                  PrimaryForeground="{DynamicResource FullLyricIdle}" PrimaryPlayedForeground="{DynamicResource FullLyricSung}"
                                  TranslationForeground="{DynamicResource FullLyricTranslation}" TranslationPlayedForeground="{DynamicResource FullLyricSung}"
                                  DistinguishActiveForeground="True" TextAlignment="Left" ItemMargin="0,11" EnableAnimation="True" EnableScale="False"
                                  ScrollDuration="0:0:0.3" UseLightweightScrollAnimation="True"
                                  SeekOnLineTap="True" AutomationProperties.Name="同步歌词"/>
                <TextBlock Name="LyricEmpty" Classes="muted" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ScrollViewer Grid.Row="1" Name="CommentsPane" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,8,12,16" Spacing="12">
                  <TextBlock Name="CommentsStatus" Classes="muted" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                  <StackPanel Name="HotComments" Spacing="8"/>
                  <StackPanel Name="LatestComments" Spacing="8"/>
                  <Button Name="MoreComments" Classes="glass-pill" Content="加载更多评论" IsVisible="False" Click="LoadMoreComments" HorizontalAlignment="Center"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
      <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" Name="DrawerLayer" ZIndex="4" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True">
        <Border Name="DrawerShade" Background="#52000000" Opacity="0" PointerPressed="CloseQueueFromBackdrop">
          <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
        </Border>
        <Border Name="QueueDrawer" Classes="glass glass-float" Width="360" Margin="0,12,12,12" HorizontalAlignment="Right" Background="{DynamicResource GlassPopup}" RenderTransform="translateX(380px)">
          <Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="BackEaseOut"/></Transitions></Border.Transitions>
          <Grid>
          <r2:GlassOptics Radius="12" Frost="{x:Static tok:DesignTokens.FrostFloating}" Saturation="{x:Static tok:DesignTokens.SaturationFloating}" Margin="1" IsHitTestVisible="False"/>
          <Grid RowDefinitions="56,*" Margin="12,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="3">
              <TextBlock Text="播放队列" Foreground="{DynamicResource R2Ink}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Name="QueueLocateButton" Classes="icon" Width="30" Height="30" Command="{Binding LocateCurrentCommand}"
                      IsVisible="{Binding HasCurrentTrack}" ToolTip.Tip="定位当前播放歌曲" AutomationProperties.Name="定位当前播放歌曲" VerticalAlignment="Center">
                <PathIcon Width="15" Height="15" Data="M9 1C5.1 1 2 4.1 2 8C2 11.9 5.1 15 9 15C12.9 15 16 11.9 16 8C16 4.1 12.9 1 9 1ZM9 13C6.2 13 4 10.8 4 8C4 5.2 6.2 3 9 3C11.8 3 14 5.2 14 8C14 10.8 11.8 13 9 13ZM10 4H8V9L12 11.5L13 10L10 8V4Z"/>
              </Button>
              <Button Grid.Column="2" Foreground="{DynamicResource R2Ink}" Content="清空" Command="{Binding Player.ClearQueueCommand}" VerticalAlignment="Center"/>
              <Button Grid.Column="3" AutomationProperties.Name="收起播放队列" Click="ToggleQueue" VerticalAlignment="Center"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassClose}"/></Button>
            </Grid>
            <ListBox Grid.Row="1" Name="DrawerItems">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Height" Value="{x:Static tok:DesignTokens.QueueRowHeight}"/></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes.song-current="{Binding IsCurrent}" Classes.unavailable="{Binding IsUnavailable}" CornerRadius="7" ToolTip.Tip="{Binding UnavailableReason}">
                    <Grid ColumnDefinitions="24,36,*,45,28" ColumnSpacing="5" Margin="2,4" Height="45">
                      <TextBlock Text="{Binding Number}" FontFeatures="tnum" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !IsCurrent}"/>
                      <r2:PlaybackWave Fill="{DynamicResource R2RedInk}" IsPlaying="{Binding IsPlaying}" IsVisible="{Binding IsCurrent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <r2:TrackArtwork Grid.Column="1" DisplaySize="36" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" HorizontalContentAlignment="Stretch" Padding="2,0" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding QueuePlayLabel}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Classes.current="{Binding IsCurrent}" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding Singer}" MaxWidth="96" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12"/>
                            <TextBlock Text="{Binding SourceLabel}" Classes="muted" FontSize="12"/>
                          </StackPanel>
                        </StackPanel>
                      </Button>
                      <TextBlock Grid.Column="3" Text="{Binding Duration}" FontFeatures="tnum" Classes="muted" VerticalAlignment="Center"/>
                      <Button Grid.Column="4" Padding="2" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveLabel}" ToolTip.Tip="移除曲目">
                        <PathIcon Width="14" Height="14" Data="M3 2L8 7L13 2L14 3L9 8L14 13L13 14L8 9L3 14L2 13L7 8L2 3Z"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="队列为空，播放或添加歌曲后会显示在这里" Classes="muted" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       IsVisible="{Binding !Player.HasQueueTracks}"/>
          </Grid>
          </Grid>
        </Border>
      </Grid>
    <Border Name="MainDock" Grid.Row="0" Grid.ColumnSpan="2" ZIndex="2" VerticalAlignment="Bottom" Classes="glass dock" Margin="12,0,12,12">
      <Grid>
        <r2:GlassOptics Radius="12" Frost="{x:Static tok:DesignTokens.FrostChrome}" Saturation="{x:Static tok:DesignTokens.SaturationChrome}" Margin="1" IsHitTestVisible="False"/>
        <Border Padding="20,8,20,8">
          <Grid Name="DockColumns" ColumnDefinitions="1*,1.5*,1*" ColumnSpacing="20">
            <Grid Name="DockTrack" ColumnDefinitions="40,*,Auto" ColumnSpacing="12" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Button Padding="0" CornerRadius="7" ToolTip.Tip="打开歌词页" AutomationProperties.Name="打开歌词页" Click="ShowLyrics">
                <r2:TrackArtwork DisplaySize="40" DataContext="{Binding Player.DisplayedPlayingSong}"/>
              </Button>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <r2:MarqueeText Text="{Binding Player.NowPlayingTitle}" Foreground="{DynamicResource R2Ink}" FontWeight="SemiBold" AutomationProperties.Name="{Binding Player.NowPlayingTitle}"/>
                <r2:MarqueeText Text="{Binding Player.DisplayedPlayingSong.Singer}" Foreground="{DynamicResource R2Muted}" FontSize="12"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Name="DockTrackActions" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                          DataContext="{Binding Player.DisplayedPlayingSong}" IsVisible="{Binding Player.HasCurrentSong}">
                <r2:HeartButton/>
                <r2:SongDownloadButton/>
              </StackPanel>
            </Grid>
            <Grid Name="DockTransport" Grid.Column="1" RowDefinitions="38,20" MaxWidth="540" VerticalAlignment="Center">
              <StackPanel Name="DockPlayButtons" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <Button Classes="icon" Width="32" Height="32" Command="{Binding Player.CycleModeCommand}" AutomationProperties.Name="{Binding Player.ModeLabel}" ToolTip.Tip="{Binding Player.ModeLabel}">
                  <Viewbox Height="18" Stretch="Uniform" Width="18">
                    <Canvas Height="24" Width="24">
                      <Path Data="{Binding Player.ModeIcon}" Fill="{DynamicResource R2Ink}"/>
                    </Canvas>
                  </Viewbox>
                </Button>
                <Button Classes="icon" Width="32" Height="32" Command="{Binding Player.PlayPreviousCommand}" ToolTip.Tip="上一首" AutomationProperties.Name="上一首"><PathIcon Width="16" Height="16" Data="M3,2 H5 V18 H3 Z M17,2 L6,10 L17,18 Z"/></Button>
                <Grid Width="38" Height="38">
                  <Button Classes="primary" Width="38" Height="38" Command="{Binding Player.TogglePlayPauseCommand}" ToolTip.Tip="播放或暂停" AutomationProperties.Name="播放或暂停">
              <Grid Width="16" Height="16">
                <PathIcon Width="15" Height="15" Foreground="White" Data="M4,2 L16,9 L4,16 Z" IsVisible="{Binding !Player.IsPlayingAudio}"/>
                <PathIcon Width="14" Height="14" Foreground="White" Data="M4,2 H7 V16 H4 Z M11,2 H14 V16 H11 Z" IsVisible="{Binding Player.IsPlayingAudio}"/>
              </Grid>
            </Button>
                  <Border Classes="buffer-ring" IsVisible="{Binding Player.IsBuffering}" IsHitTestVisible="False" Margin="-3" BorderThickness="1.5"
                          CornerRadius="999" BorderBrush="{DynamicResource R2BrandGradient}" AutomationProperties.Name="正在缓冲"/>
                </Grid>
                <Button Classes="icon" Width="32" Height="32" Command="{Binding Player.PlayNextCommand}" ToolTip.Tip="下一首" AutomationProperties.Name="下一首"><PathIcon Width="16" Height="16" Data="M3,2 L14,10 L3,18 Z M15,2 H17 V18 H15 Z"/></Button>
                <Button Name="DesktopLyricToggle" Classes="glass-pill desktop-lyric" Click="ToggleDesktopLyrics" AutomationProperties.Name="桌面歌词开关"><PathIcon Width="16" Height="16" Data="M1 1H15V11H1Z M3 3V9H13V3Z M7 11H9V13H12V15H4V13H7Z"/></Button>
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="38,*,38" VerticalAlignment="Center">
                <TextBlock Text="{Binding Player.PositionText}" Classes="muted" FontFeatures="tnum" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" AutomationProperties.AutomationId="M223.Progress"/>
                <local:CommitSlider Grid.Column="1" Name="DesktopProgress" Classes="progress" Margin="10,0" AutomationProperties.Name="播放进度"/>
                <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" Classes="muted" FontFeatures="tnum" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </Grid>
            <Grid Name="DockUtilities" Grid.Column="2" RowDefinitions="32,28" HorizontalAlignment="Right" VerticalAlignment="Center">
              <StackPanel Name="DockUtilityButtons" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Classes="icon" Width="32" Height="32" Command="{Binding Player.MuteCommand}" ToolTip.Tip="静音或恢复音量" AutomationProperties.Name="静音或恢复音量">
              <Grid Width="16" Height="16">
                <PathIcon Data="M2,6 H6 L11,2 V18 L6,14 H2 Z M13,5 Q19,10 13,15 L12,14 Q16,10 12,6 Z" IsVisible="{Binding !Player.IsMuted}"/>
                <PathIcon Data="M2,6 H6 L11,2 V18 L6,14 H2 Z M13,7 L14,6 L20,12 L19,13 Z M19,6 L20,7 L14,13 L13,12 Z" IsVisible="{Binding Player.IsMuted}"/>
              </Grid>
            </Button>
                  <local:CommitSlider Name="VolumeSlider" Width="76" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="音量"/>
                </StackPanel>
                <Button Classes="icon" Width="28" Height="28" IsVisible="{Binding Player.DisplayedPlayingSong.CanUseOnlineActions}" Click="ShowCurrentComments" AutomationProperties.Name="查看评论" ToolTip.Tip="查看评论"><PathIcon Width="15" Height="15" Data="M1 2H15V12H8L4 16V12H1Z M3 4V10H6V12L8 10H13V4Z M5 6H11V8H5Z"/></Button>
                <Button Name="DockQueueButton" Classes="icon" Click="ToggleQueue" ToolTip.Tip="{Binding Player.QueueCountTooltip}" AutomationProperties.Name="播放队列">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="16" Height="16" Data="M1 2H15V4H1Z M1 7H11V9H1Z M1 12H9V14H1Z M12 10L16 12.5L12 15Z"/>
                    <Border Name="DockQueueBadge" MinWidth="24" Height="20" Padding="8,0" CornerRadius="999" HorizontalAlignment="Right" Background="{DynamicResource R2Tint}">
                      <TextBlock Text="{Binding Player.QueueBadgeText}" FontFeatures="tnum" Foreground="{DynamicResource R2RedInk}" FontSize="13" FontWeight="Medium" TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Row="1" HorizontalAlignment="Right">
                <ComboBox Name="QualityChoice" MinWidth="88" MinHeight="28" Padding="10,3" Background="{DynamicResource R2Side}" Foreground="{DynamicResource R2Ink}" BorderBrush="{DynamicResource R2Edge}" AutomationProperties.Name="播放音质" ToolTip.Tip="用于下一次打开音源" SelectionChanged="ChangeQuality">
              <ComboBoxItem>标准音质</ComboBoxItem><ComboBoxItem>高品 MP3</ComboBoxItem><ComboBoxItem>无损 FLAC</ComboBoxItem>
            </ComboBox>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" Name="CommentDrawerLayer" ZIndex="5" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True">
      <Border Name="CommentDrawerShade" Background="#52000000" Opacity="0" PointerPressed="CloseSongCommentsFromShade">
        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
      </Border>
      <Border Name="CommentDrawer" Classes="glass glass-float" Width="430" Margin="0,12,12,12" HorizontalAlignment="Right" Background="{DynamicResource GlassPopup}" RenderTransform="translateX(444px)">
        <Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="BackEaseOut"/></Transitions></Border.Transitions>
        <Grid>
          <r2:GlassOptics Radius="12" Frost="{x:Static tok:DesignTokens.FrostFloating}" Saturation="{x:Static tok:DesignTokens.SaturationFloating}" Margin="1" IsHitTestVisible="False"/>
          <Grid RowDefinitions="Auto,*" Margin="16">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="歌曲评论" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Name="DrawerCommentCount" FontFeatures="tnum" Classes="muted" VerticalAlignment="Center"/>
                </StackPanel>
                <SelectableTextBlock Name="DrawerCommentTitle" Classes="muted" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1" Click="CloseSongComments" AutomationProperties.Name="收起歌曲评论"><PathIcon Width="14" Height="14" Data="{DynamicResource GlassClose}"/></Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Name="DrawerCommentScroll">
              <StackPanel Spacing="8">
                <TextBlock Name="DrawerCommentStatus" Classes="muted"/>
                <StackPanel Name="DrawerCommentHot" Spacing="8"/>
                <StackPanel Name="DrawerCommentLatest" Spacing="8"/>
                <Button Name="DrawerCommentMore" Click="LoadDrawerComments" Classes="glass-pill" HorizontalAlignment="Center"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Name="ToastPlate" Grid.ColumnSpan="2" ZIndex="6" IsVisible="False" IsHitTestVisible="False"
            Margin="20,0,20,24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="16,12" CornerRadius="12"
            Background="{DynamicResource R2Main}" BorderBrush="{DynamicResource R2Pink}" BorderThickness="1"
            BoxShadow="{DynamicResource GlassLiftL3}">
      <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
      <TextBlock Name="ToastText" FontWeight="Medium" Foreground="{DynamicResource R2Ink}" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</UserControl>
