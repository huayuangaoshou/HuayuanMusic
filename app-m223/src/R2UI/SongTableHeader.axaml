<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HuayuanPreview.R2.SongTableHeader" x:CompileBindings="False"><StackPanel><TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#75829A" Margin="6,4"/><Grid ColumnDefinitions="2*,*,60,54,54" Margin="6,10,8,10"><StackPanel Orientation="Horizontal"><Button Content="歌曲" Command="{Binding SortTitleCommand}"/><Button Content="歌手" Command="{Binding SortArtistCommand}"/></StackPanel><Button Grid.Column="1" Content="专辑" Command="{Binding SortAlbumCommand}" HorizontalContentAlignment="Left"/><TextBlock Grid.Column="2" Text="时长"/><TextBlock Grid.Column="3" Grid.ColumnSpan="2" Name="ActionHeading" Text="操作"/></Grid></StackPanel></UserControl>
