<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r2="using:HuayuanPreview.R2">
  <Styles.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="Primary" Color="#4A9BFF"/>
      <SolidColorBrush x:Key="R2Accent" Color="#4A9BFF"/>
      <SolidColorBrush x:Key="R2Pink" Color="#FF6FA5"/>
      <StreamGeometry x:Key="R2Heart">M12,20.5 C10.75,19.62 3,14.25 3,8.95 C3,6.08 5.22,4 7.91,4 C9.64,4 11.12,4.86 12,6.16 C12.88,4.86 14.36,4 16.09,4 C18.78,4 21,6.08 21,8.95 C21,14.25 13.25,19.62 12,20.5 Z</StreamGeometry>
      <LinearGradientBrush x:Key="R2HeartFill" StartPoint="0%,0%" EndPoint="80%,100%">
        <GradientStop Color="#FF82AC" Offset="0"/><GradientStop Color="#FF4D7D" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="R2BrandGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#FF6FA5" Offset="0"/><GradientStop Color="#4A9BFF" Offset="1"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="R2AccentHover" Color="#5276C8"/>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="GlassBase" Color="#F9FBFF"/>
          <SolidColorBrush x:Key="GlassSurface" Color="#CCFFFFFF"/>
          <SolidColorBrush x:Key="GlassSide" Color="#B8F4F9FF"/>
          <SolidColorBrush x:Key="GlassPopup" Color="#F5FFFFFF"/>
          <SolidColorBrush x:Key="LyricActive" Color="#0F172A"/>
          <SolidColorBrush x:Key="LyricIdle" Color="#475569"/>
          <SolidColorBrush x:Key="TranslationActive" Color="#334155"/>
          <SolidColorBrush x:Key="TranslationIdle" Color="#64748B"/>
          <LinearGradientBrush x:Key="GlassRim" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F2FFFFFF" Offset="0"/><GradientStop Color="#559ECBFF" Offset="1"/>
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="GlassPinkGlow" Center="20%,8%" GradientOrigin="20%,8%" RadiusX="62%" RadiusY="72%">
            <GradientStop Color="#26FF8AB8" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <RadialGradientBrush x:Key="GlassBlueGlow" Center="92%,90%" GradientOrigin="92%,90%" RadiusX="63%" RadiusY="72%">
            <GradientStop Color="#2B6CB8FF" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <SolidColorBrush x:Key="R2Main" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="R2Side" Color="#F2F7FF"/>
          <SolidColorBrush x:Key="R2Edge" Color="#DCE8FA"/>
          <SolidColorBrush x:Key="R2Ink" Color="#1E293B"/>
          <SolidColorBrush x:Key="R2Muted" Color="#64748B"/>
          <SolidColorBrush x:Key="R2Hover" Color="#EDF4FF"/>
          <SolidColorBrush x:Key="R2Stripe" Color="#F6FAFF"/>
          <SolidColorBrush x:Key="R2Tint" Color="#FCECF5"/>
          <SolidColorBrush x:Key="R2RedInk" Color="#AD3373"/>
          <LinearGradientBrush x:Key="R2LyricVeil" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#BDFEF2FB" Offset="0"/><GradientStop Color="#C5EDF7FF" Offset="0.61"/><GradientStop Color="#EBFFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="GlassBase" Color="#0E1422"/>
          <SolidColorBrush x:Key="GlassSurface" Color="#8C162033"/>
          <SolidColorBrush x:Key="GlassSide" Color="#A0172235"/>
          <SolidColorBrush x:Key="GlassPopup" Color="#F21B263B"/>
          <SolidColorBrush x:Key="LyricActive" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="LyricIdle" Color="#94A3B8"/>
          <SolidColorBrush x:Key="TranslationActive" Color="#CBD5E1"/>
          <SolidColorBrush x:Key="TranslationIdle" Color="#64748B"/>
          <LinearGradientBrush x:Key="GlassRim" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#699AC5FC" Offset="0"/><GradientStop Color="#559ECBFF" Offset="1"/>
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="GlassPinkGlow" Center="20%,8%" GradientOrigin="20%,8%" RadiusX="62%" RadiusY="72%">
            <GradientStop Color="#25D06498" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <RadialGradientBrush x:Key="GlassBlueGlow" Center="92%,90%" GradientOrigin="92%,90%" RadiusX="63%" RadiusY="72%">
            <GradientStop Color="#36648CDC" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <SolidColorBrush x:Key="R2Main" Color="#111622"/>
          <SolidColorBrush x:Key="R2Side" Color="#161D2C"/>
          <SolidColorBrush x:Key="R2Edge" Color="#29354B"/>
          <SolidColorBrush x:Key="R2Ink" Color="#F2F3F5"/>
          <SolidColorBrush x:Key="R2Muted" Color="#A0A5B1"/>
          <SolidColorBrush x:Key="R2Hover" Color="#202E46"/>
          <SolidColorBrush x:Key="R2Stripe" Color="#151D2D"/>
          <SolidColorBrush x:Key="R2Tint" Color="#382942"/>
          <SolidColorBrush x:Key="R2RedInk" Color="#FFA0C2"/>
          <LinearGradientBrush x:Key="R2LyricVeil" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#9F271C37" Offset="0"/><GradientStop Color="#A115243C" Offset="0.55"/><GradientStop Color="#DE111622" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
  </Style>
  <Style Selector="Border.dock"><Setter Property="CornerRadius" Value="22"/><Setter Property="BoxShadow" Value="0 5 22 0 #214783B5"/></Style>
  <Style Selector="Border.dock:pointerover"><Setter Property="Background" Value="{DynamicResource GlassPopup}"/></Style>
  <Style Selector="Border.buffer-ring">
    <Style.Animations><Animation Duration="0:0:0.68" IterationCount="Infinite" PlaybackDirection="Alternate">
      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.28"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="SelectableTextBlock"><Setter Property="Focusable" Value="True"/><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/><Setter Property="SelectionBrush" Value="#667DC9FF"/></Style>
  <Style Selector="SelectableTextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="Button.glass-pill"><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{DynamicResource GlassSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Button.glass-pill.selected"><Setter Property="Background" Value="{DynamicResource R2Tint}"/></Style>
  <Style Selector="Button.desktop-lyric"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="Button.desktop-lyric.selected">
    <Setter Property="Background" Value="{DynamicResource R2BrandGradient}"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.desktop-lyric.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2BrandGradient}"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter"><Setter Property="Background" Value="{DynamicResource GlassPopup}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/><Setter Property="CornerRadius" Value="14"/></Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="TextBlock.current"><Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/></Style>
  <Style Selector="Button">
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2Hover}"/>
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/>
  </Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2Tint}"/>
    <Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource R2Accent}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource R2BrandGradient}"/><Setter Property="Foreground" Value="#142540"/>
    <Setter Property="CornerRadius" Value="100"/><Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/></Transitions></Setter>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2AccentHover}"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pressed"><Setter Property="RenderTransform" Value="scale(0.9)"/></Style>
  <Style Selector="Button.heart Path"><Setter Property="Stroke" Value="{DynamicResource R2Muted}"/><Setter Property="Fill" Value="Transparent"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.20" Easing="CubicEaseOut"/></Transitions></Setter>
  </Style>
  <Style Selector="Button.heart:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource R2Pink}"/></Style>
  <Style Selector="Button.heart.liked Path"><Setter Property="Fill" Value="{DynamicResource R2HeartFill}"/><Setter Property="Stroke" Value="#FF4D7D"/></Style>
  <Style Selector="Button.heart:pressed Path"><Setter Property="RenderTransform" Value="scale(1.24)"/></Style>
  <Style Selector="Border.song-current"><Setter Property="Background" Value="{DynamicResource R2Tint}"/></Style>
  <Style Selector="Border.unavailable TextBlock"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="Border.unavailable r2|TrackArtwork"><Setter Property="Opacity" Value="0.55"/></Style>
  <Style Selector="Path.empty-heart"><Setter Property="Data" Value="{DynamicResource R2Heart}"/><Setter Property="Stroke" Value="{DynamicResource R2Muted}"/><Setter Property="StrokeThickness" Value="1.8"/></Style>
  <Style Selector="MenuFlyoutPresenter MenuItem"><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/></Style>
  <Style Selector="ContextMenu MenuItem"><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/></Style>
  <Style Selector="StackPanel.row-actions"><Setter Property="Opacity" Value="0"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions></Setter></Style>
  <Style Selector="ListBoxItem:pointerover StackPanel.row-actions"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="ListBoxItem:focus-within StackPanel.row-actions"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Border.wave-bar"><Setter Property="Background" Value="{DynamicResource R2Pink}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
    <Style.Animations><Animation Duration="0:0:0.52" IterationCount="Infinite" PlaybackDirection="Alternate"><KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.35"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame></Animation></Style.Animations>
  </Style>
  <Style Selector="Button.caption"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource R2Accent}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/><Setter Property="PlaceholderForeground" Value="{DynamicResource R2Muted}"/>
    <Setter Property="Background" Value="{DynamicResource R2Side}"/><Setter Property="BorderBrush" Value="{DynamicResource R2Edge}"/>
    <Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="13,6"/><Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="ListBox.songs > ListBoxItem:nth-child(even)"><Setter Property="Background" Value="{DynamicResource R2Stripe}"/></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource R2Hover}"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource R2Tint}"/><Setter Property="BorderBrush" Value="{DynamicResource R2Accent}"/></Style>
  <Style Selector="Slider"><Setter Property="Foreground" Value="{DynamicResource R2Accent}"/><Setter Property="Background" Value="{DynamicResource R2Edge}"/></Style>
  <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton"><Setter Property="Background" Value="{DynamicResource R2BrandGradient}"/></Style>
  <Style Selector="Slider /template/ Thumb"><Setter Property="Background" Value="{DynamicResource R2Accent}"/></Style>
  <Style Selector="Slider.progress"><Setter Property="Foreground" Value="{DynamicResource R2Accent}"/></Style>
  <Style Selector="Slider.progress /template/ Thumb"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="scale(0.7)"/></Style>
  <Style Selector="Slider.progress:pointerover /template/ Thumb"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="scale(1.2)"/></Style>
  <Style Selector="Slider.progress.editing /template/ Thumb"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Border.playlist-tile">
    <Setter Property="RenderTransform" Value="translateY(0px)"/>
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/></Transitions></Setter>
  </Style>
  <Style Selector="Border.playlist-tile:pointerover"><Setter Property="RenderTransform" Value="translateY(-4px)"/></Style>
  <Style Selector="Button.card-play"><Setter Property="Opacity" Value="0"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18"/></Transitions></Setter></Style>
  <Style Selector="Border.playlist-tile:pointerover Button.card-play"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Button.card-play:focus-visible"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="TextBlock.wave"><Style.Animations><Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate"><KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame></Animation></Style.Animations></Style>
</Styles>
