<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r2="using:HuayuanPreview.R2" xmlns:tok="using:HuayuanPreview">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- 颜色唯一来源：DesignTokens。视觉表现层不得散写硬编码 hex。 -->
      <SolidColorBrush x:Key="NoticeSurface" Color="#F2121212"/>
      <SolidColorBrush x:Key="NoticeInk" Color="#F2FFFFFF"/>
      <SolidColorBrush x:Key="GlassTopLight" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="Primary" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
      <SolidColorBrush x:Key="R2Accent" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
      <SolidColorBrush x:Key="R2Pink" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
      <StreamGeometry x:Key="GlassBack">M10 2L4 8L10 14L11.2 12.8L6.4 8L11.2 3.2Z</StreamGeometry>
      <StreamGeometry x:Key="GlassForward">M6 2L12 8L6 14L4.8 12.8L9.6 8L4.8 3.2Z</StreamGeometry>
      <StreamGeometry x:Key="GlassMinimize">M2 7.25H14V8.75H2Z</StreamGeometry>
      <StreamGeometry x:Key="GlassMaximize">M2 2H14V14H2Z M3.5 3.5V12.5H12.5V3.5Z</StreamGeometry>
      <StreamGeometry x:Key="GlassClose">M3.5 2.5L8 7L12.5 2.5L13.5 3.5L9 8L13.5 12.5L12.5 13.5L8 9L3.5 13.5L2.5 12.5L7 8L2.5 3.5Z</StreamGeometry>
      <StreamGeometry x:Key="GlassMoon">M13.5 10.5C6.6 11.9 4.2 5.9 7.2 2C2.1 2.5 .5 8.8 3.5 12.1C6 15 11.3 15 13.5 10.5Z</StreamGeometry>
      <StreamGeometry x:Key="R2Heart">M12,20.5 C10.75,19.62 3,14.25 3,8.95 C3,6.08 5.22,4 7.91,4 C9.64,4 11.12,4.86 12,6.16 C12.88,4.86 14.36,4 16.09,4 C18.78,4 21,6.08 21,8.95 C21,14.25 13.25,19.62 12,20.5 Z</StreamGeometry>
      <SolidColorBrush x:Key="R2HeartFill" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
      <SolidColorBrush x:Key="R2BrandGradient" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
      <SolidColorBrush x:Key="R2AccentHover" Color="{x:Static tok:DesignTokens.AccentMid}"/>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DesktopLyricPlate" Color="#201C29"/>
          <x:Double x:Key="FullLyricArtworkOpacity">.43</x:Double>
          <x:Boolean x:Key="GlassClearNeedsDim">True</x:Boolean>
          <SolidColorBrush x:Key="UpdateActionFill" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
          <SolidColorBrush x:Key="UpdateActionHover" Color="{x:Static tok:DesignTokens.AccentMid}"/>
          <SolidColorBrush x:Key="UpdateActionInk" Color="{x:Static tok:DesignTokens.LightText}"/>
          <!-- R11 阴影分档：L2 chrome 8/24 α0.18，L3 floating 16/48 α0.25（层级越高阴影越大越淡）。中性色唯一来源。 -->
          <BoxShadows x:Key="GlassLift">0 8 24 0 #2E0F172A</BoxShadows>
          <BoxShadows x:Key="GlassLiftL3">0 16 48 0 #400F172A</BoxShadows>
          <LinearGradientBrush x:Key="GlassKnob" StartPoint="15%,0%" EndPoint="90%,100%">
            <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F2D9EDFF" Offset="0.52"/><GradientStop Color="#FF9FC6F0" Offset="1"/>
          </LinearGradientBrush>
          <SolidColorBrush x:Key="GlassScrollThumb" Color="#906789B2"/>
          <SolidColorBrush x:Key="GlassRail" Color="#A8A2C4E8"/>
          <SolidColorBrush x:Key="R2Focus" Color="#3269A8"/>
          <SolidColorBrush x:Key="GlassBase" Color="#F7F9FC"/>
          <SolidColorBrush x:Key="GlassSurface" Color="#F7FFFFFF"/>
          <SolidColorBrush x:Key="GlassSide" Color="#B8F4F9FF"/>
          <SolidColorBrush x:Key="GlassPopup" Color="#D9FFFFFF"/>
          <SolidColorBrush x:Key="ModalScrim" Color="#521C2940"/>
          <SolidColorBrush x:Key="LyricActive" Color="#0F172A"/>
          <SolidColorBrush x:Key="LyricIdle" Color="#475569"/>
          <SolidColorBrush x:Key="TranslationActive" Color="#334155"/>
          <SolidColorBrush x:Key="TranslationIdle" Color="#52637A"/>
          <LinearGradientBrush x:Key="GlassRim" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E6EEF8" Offset="0"/><GradientStop Color="#F2FFFFFF" Offset="0.38"/><GradientStop Color="#7792BFFF" Offset="0.84"/><GradientStop Color="#55F096C4" Offset="1"/>
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="GlassPinkGlow" Center="20%,8%" GradientOrigin="20%,8%" RadiusX="62%" RadiusY="72%">
            <GradientStop Color="#4DFF8AB8" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <RadialGradientBrush x:Key="GlassBlueGlow" Center="92%,90%" GradientOrigin="92%,90%" RadiusX="63%" RadiusY="72%">
            <GradientStop Color="#556CB8FF" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <SolidColorBrush x:Key="R2Main" Color="{x:Static tok:DesignTokens.LightSurface}"/>
          <SolidColorBrush x:Key="R2Side" Color="{x:Static tok:DesignTokens.LightBase}"/>
          <SolidColorBrush x:Key="R2Edge" Color="{x:Static tok:DesignTokens.LightLine}"/>
          <SolidColorBrush x:Key="R2Ink" Color="{x:Static tok:DesignTokens.LightText}"/>
          <SolidColorBrush x:Key="R2Muted" Color="{x:Static tok:DesignTokens.LightSub}"/>
          <SolidColorBrush x:Key="R2Hover" Color="{x:Static tok:DesignTokens.LightHover}"/>
          <SolidColorBrush x:Key="R2Stripe" Color="{x:Static tok:DesignTokens.LightStripe}"/>
          <SolidColorBrush x:Key="R2Tint" Color="{x:Static tok:DesignTokens.AccentSoft}"/>
          <SolidColorBrush x:Key="R2RowBase" Color="{x:Static tok:DesignTokens.LightRowBase}"/>
          <SolidColorBrush x:Key="R2RowHover" Color="{x:Static tok:DesignTokens.AccentSoftHover}"/>
          <SolidColorBrush x:Key="R2RedInk" Color="{x:Static tok:DesignTokens.LightAccentInk}"/>
          <LinearGradientBrush x:Key="R2LyricVeil" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="FullLyricVeil" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#28FFFFFF" Offset="0"/><GradientStop Color="#4DFFFFFF" Offset="0.5"/><GradientStop Color="#28FFFFFF" Offset="1"/>
          </LinearGradientBrush>
          <!-- R7补丁1：浅色歌词显形。Idle/Translation 用 Text/Sub 半透明，Sung 用饱和深粉渐变，浅底上卡拉OK扫动可见。 -->
          <SolidColorBrush x:Key="FullLyricIdle" Color="#992A2530"/>
          <SolidColorBrush x:Key="FullLyricTranslation" Color="#887A7385"/>
          <LinearGradientBrush x:Key="FullLyricSung" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E88AB8" Offset="0"/><GradientStop Color="#E86FA5" Offset="0.5"/><GradientStop Color="#8FA8E8" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="FullLyricBack" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{x:Static tok:DesignTokens.LightBase}" Offset="0"/><GradientStop Color="{x:Static tok:DesignTokens.LightSurface}" Offset="0.5"/><GradientStop Color="{x:Static tok:DesignTokens.LightBase}" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DesktopLyricPlate" Color="#161D2C"/>
          <x:Double x:Key="FullLyricArtworkOpacity">.26</x:Double>
          <x:Boolean x:Key="GlassClearNeedsDim">False</x:Boolean>
          <SolidColorBrush x:Key="UpdateActionFill" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
          <SolidColorBrush x:Key="UpdateActionHover" Color="{x:Static tok:DesignTokens.AccentMid}"/>
          <SolidColorBrush x:Key="UpdateActionInk" Color="{x:Static tok:DesignTokens.LightText}"/>
          <BoxShadows x:Key="GlassLift">0 8 24 0 #2E101A31</BoxShadows>
          <BoxShadows x:Key="GlassLiftL3">0 16 48 0 #400A142B</BoxShadows>
          <LinearGradientBrush x:Key="GlassKnob" StartPoint="15%,0%" EndPoint="90%,100%">
            <GradientStop Color="#D9C8E4FF" Offset="0"/><GradientStop Color="#687CBAEE" Offset="0.52"/><GradientStop Color="#70617CC8" Offset="1"/>
          </LinearGradientBrush>
          <SolidColorBrush x:Key="GlassScrollThumb" Color="#A09ABFE5"/>
          <SolidColorBrush x:Key="GlassRail" Color="#A4476082"/>
          <SolidColorBrush x:Key="R2Focus" Color="#7DC2FF"/>
          <SolidColorBrush x:Key="GlassBase" Color="#0E1422"/>
          <SolidColorBrush x:Key="GlassSurface" Color="#8C162033"/>
          <SolidColorBrush x:Key="GlassSide" Color="#A0172235"/>
          <SolidColorBrush x:Key="GlassPopup" Color="#D91B263B"/>
          <SolidColorBrush x:Key="ModalScrim" Color="#88060912"/>
          <SolidColorBrush x:Key="LyricActive" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="LyricIdle" Color="#94A3B8"/>
          <SolidColorBrush x:Key="TranslationActive" Color="#CBD5E1"/>
          <SolidColorBrush x:Key="TranslationIdle" Color="#A2B0C5"/>
          <LinearGradientBrush x:Key="GlassRim" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#ABC4E0FF" Offset="0"/><GradientStop Color="#6BA5C8FF" Offset="0.35"/><GradientStop Color="#686C95D6" Offset="0.82"/><GradientStop Color="#54DB91C8" Offset="1"/>
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="GlassPinkGlow" Center="20%,8%" GradientOrigin="20%,8%" RadiusX="62%" RadiusY="72%">
            <GradientStop Color="#4DD06498" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <RadialGradientBrush x:Key="GlassBlueGlow" Center="92%,90%" GradientOrigin="92%,90%" RadiusX="63%" RadiusY="72%">
            <GradientStop Color="#5A648CDC" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
          <SolidColorBrush x:Key="R2Main" Color="{x:Static tok:DesignTokens.DarkSurface}"/>
          <SolidColorBrush x:Key="R2Side" Color="{x:Static tok:DesignTokens.DarkBase}"/>
          <SolidColorBrush x:Key="R2Edge" Color="{x:Static tok:DesignTokens.DarkLine}"/>
          <SolidColorBrush x:Key="R2Ink" Color="{x:Static tok:DesignTokens.DarkText}"/>
          <SolidColorBrush x:Key="R2Muted" Color="{x:Static tok:DesignTokens.DarkSub}"/>
          <SolidColorBrush x:Key="R2Hover" Color="{x:Static tok:DesignTokens.DarkHover}"/>
          <SolidColorBrush x:Key="R2Stripe" Color="{x:Static tok:DesignTokens.DarkStripe}"/>
          <SolidColorBrush x:Key="R2Tint" Color="{x:Static tok:DesignTokens.DarkTint}"/>
          <SolidColorBrush x:Key="R2RowBase" Color="{x:Static tok:DesignTokens.DarkRowBase}"/>
          <SolidColorBrush x:Key="R2RowHover" Color="{x:Static tok:DesignTokens.AccentSoftHover}"/>
          <SolidColorBrush x:Key="R2RedInk" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
          <LinearGradientBrush x:Key="R2LyricVeil" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#72080D18" Offset="0"/><GradientStop Color="#A0080D18" Offset="0.55"/><GradientStop Color="#D90A101C" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="FullLyricVeil" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.5"/><GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
          <SolidColorBrush x:Key="FullLyricIdle" Color="{x:Static tok:DesignTokens.DarkText}"/>
          <SolidColorBrush x:Key="FullLyricTranslation" Color="{x:Static tok:DesignTokens.DarkSub}"/>
          <SolidColorBrush x:Key="FullLyricSung" Color="{x:Static tok:DesignTokens.AccentStrong}"/>
          <LinearGradientBrush x:Key="FullLyricBack" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{x:Static tok:DesignTokens.DarkBase}" Offset="0"/><GradientStop Color="{x:Static tok:DesignTokens.DarkSurface}" Offset="0.5"/><GradientStop Color="{x:Static tok:DesignTokens.DarkBase}" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Border.desktop-lyric-plate">
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="{DynamicResource DesktopLyricPlate}"/>
  </Style>
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Border.porcelain">
    <Setter Property="Background" Value="{DynamicResource R2Main}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Border.glass-clear">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.playlist-tile">
    <Setter Property="Background" Value="{DynamicResource R2Main}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Border.dock"><Setter Property="CornerRadius" Value="12"/><Setter Property="BoxShadow" Value="{DynamicResource GlassLift}"/></Style>
  <Style Selector="Border.glass-float"><Setter Property="CornerRadius" Value="12"/><Setter Property="BoxShadow" Value="{DynamicResource GlassLiftL3}"/></Style>
  <Style Selector="Border.glass-side"><Setter Property="CornerRadius" Value="12"/><Setter Property="BoxShadow" Value="{DynamicResource GlassLift}"/></Style>
  <Style Selector="Grid.modal-scrim"><Setter Property="Background" Value="{DynamicResource ModalScrim}"/></Style>
  <Style Selector="ScrollViewer.update-scroll">
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="Transparent"/>
        <GradientStop Offset="0.025" Color="Black"/>
        <GradientStop Offset="0.975" Color="Black"/>
        <GradientStop Offset="1" Color="Transparent"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="SelectableTextBlock.update-notes">
    <Setter Property="FontFamily" Value="{x:Static tok:DesignTokens.LyricSerif}"/>
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.StateCopySize}"/>
    <Setter Property="LineHeight" Value="{x:Static tok:DesignTokens.NoticeLineHeight}"/>
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource R2Main}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource R2Pink}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="TextBlock.toast-copy">
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/>
  </Style>
  <Style Selector="Border.toast.notice">
    <Setter Property="Background" Value="{DynamicResource NoticeSurface}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="CornerRadius" Value="{x:Static tok:DesignTokens.NoticeRadius}"/>
  </Style>
  <Style Selector="Border.notice TextBlock.toast-copy">
    <Setter Property="Foreground" Value="{DynamicResource NoticeInk}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.StateCopySize}"/>
    <Setter Property="FontFamily" Value="{x:Static tok:DesignTokens.LyricSerif}"/>
    <Setter Property="LineHeight" Value="{x:Static tok:DesignTokens.NoticeLineHeight}"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.state-empty-copy">
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.StateCopySize}"/>
    <Setter Property="FontFamily" Value="{x:Static tok:DesignTokens.LyricSerif}"/>
    <Setter Property="LineHeight" Value="{x:Static tok:DesignTokens.NoticeLineHeight}"/>
  </Style>
  <Style Selector="TextBlock.state-error-copy">
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.StateCopySize}"/>
  </Style>
  <Style Selector="PathIcon.state-note"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="Border.state-skeleton">
    <Setter Property="Background" Value="{DynamicResource R2RowBase}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource R2Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Opacity" Value="0.75"/>
  </Style>
  <Style Selector="TextBlock.track-title, SelectableTextBlock.track-title, TextBlock.section-title, SelectableTextBlock.section-title, SelectableTextBlock.playing-title">
    <Setter Property="FontFamily" Value="{x:Static tok:DesignTokens.LyricSerif}"/>
    <Setter Property="LetterSpacing" Value="{x:Static tok:DesignTokens.TitleTracking}"/>
  </Style>
  <Style Selector="TextBlock.section-title, SelectableTextBlock.section-title">
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.BlockTitleSize}"/>
  </Style>
  <Style Selector="SelectableTextBlock.playing-title">
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.PlayingTitleSize}"/>
  </Style>
  <Style Selector="TextBlock.track-title, SelectableTextBlock.track-title">
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.FontXl}"/>
  </Style>
  <Style Selector="TextBlock.track-caption, SelectableTextBlock.track-caption">
    <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.TrackingCaptionSize}"/>
    <Setter Property="LetterSpacing" Value="{x:Static tok:DesignTokens.CaptionTracking}"/>
  </Style>
  <Style Selector="Border.glass-edge">
    <Setter Property="BorderBrush" Value="{DynamicResource GlassTopLight}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Margin" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="Border.glass-enter, Grid.glass-enter">
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform"><ScaleTransform/></Setter>
    <Style.Animations>
      <Animation Duration="{x:Static tok:DesignTokens.MotionEffectsSlowDuration}" Easing="{x:Static tok:DesignTokens.EmphasizedDecelerate}">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
      <Animation Duration="{x:Static tok:DesignTokens.MotionSpatialDefaultDuration}" Easing="{x:Static tok:DesignTokens.MotionSpatialDefaultEasing}">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value=".98"/><Setter Property="ScaleTransform.ScaleY" Value=".98"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.popup-enter, MenuFlyoutPresenter.popup-enter, ContextMenu.popup-enter">
    <Setter Property="RenderTransformOrigin" Value="0%,0%"/>
    <Setter Property="RenderTransform"><ScaleTransform/></Setter>
    <Style.Animations>
      <Animation Duration="{x:Static tok:DesignTokens.MotionEffectsFastDuration}" Easing="{x:Static tok:DesignTokens.EmphasizedDecelerate}">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
      <Animation Duration="{x:Static tok:DesignTokens.MotionSpatialFastDuration}" Easing="{x:Static tok:DesignTokens.MotionSpatialFastEasing}">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value=".96"/><Setter Property="ScaleTransform.ScaleY" Value=".96"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="r2|StateViews.state-loading Border.state-skeleton">
    <Style.Animations>
      <Animation Duration="{x:Static tok:DesignTokens.BufferPulseDuration}" Easing="{x:Static tok:DesignTokens.MotionEffectsSlowEasing}" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.buffer-ring">
    <Style.Animations><Animation Duration="{x:Static tok:DesignTokens.BufferPulseDuration}" Easing="{x:Static tok:DesignTokens.MotionEffectsSlowEasing}" IterationCount="Infinite" PlaybackDirection="Alternate">
      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.28"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="SelectableTextBlock"><Setter Property="Focusable" Value="True"/><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/><Setter Property="SelectionBrush" Value="#667DC9FF"/></Style>
  <Style Selector="SelectableTextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="Button.glass-pill"><Setter Property="CornerRadius" Value="999"/><Setter Property="Background" Value="{DynamicResource R2Main}"/><Setter Property="BorderBrush" Value="{DynamicResource R2Edge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="Button.glass-pill.selected"><Setter Property="Background" Value="{DynamicResource R2Tint}"/><Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/></Style>
  <Style Selector="Button.desktop-lyric"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="Button.desktop-lyric.selected">
    <Setter Property="Background" Value="{DynamicResource R2Tint}"/><Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/>
  </Style>
  <Style Selector="Button.desktop-lyric.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2Tint}"/><Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/>
  </Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="TextBlock.current"><Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/></Style>
  <Style Selector="Button">
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2Hover}"/>
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/>
  </Style>
  <Style Selector="Button.update-primary, Button.update-ghost">
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button.update-primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UpdateActionFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource UpdateActionInk}"/>
  </Style>
  <Style Selector="Button.update-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UpdateActionHover}"/>
  </Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2Tint}"/>
    <Setter Property="Foreground" Value="{DynamicResource R2RedInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource R2Accent}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource R2BrandGradient}"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="999"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource R2BrandGradient}"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.heart"><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.heart /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.heart:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.heart Path"><Setter Property="Stroke" Value="{DynamicResource R2Muted}"/><Setter Property="Fill" Value="Transparent"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{x:Static tok:DesignTokens.MotionSpatialFastDuration}" Easing="{x:Static tok:DesignTokens.MotionSpatialFastEasing}"/></Transitions></Setter>
  </Style>
  <Style Selector="Button.heart:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource R2Pink}"/><Setter Property="RenderTransform" Value="scale(1.1)"/></Style>
  <Style Selector="Button.heart.liked Path"><Setter Property="Fill" Value="{DynamicResource R2HeartFill}"/><Setter Property="Stroke" Value="#FF4D7D"/></Style>
  <Style Selector="Button.heart:pressed Path"><Setter Property="RenderTransform" Value="scale(0.98)"/></Style>
  <Style Selector="Border.song-current"><Setter Property="Background" Value="{DynamicResource R2Tint}"/></Style>
  <Style Selector="Border.unavailable TextBlock"><Setter Property="Foreground" Value="{DynamicResource R2Muted}"/></Style>
  <Style Selector="Border.unavailable r2|TrackArtwork"><Setter Property="Opacity" Value="0.55"/></Style>
  <Style Selector="Path.empty-heart"><Setter Property="Data" Value="{DynamicResource R2Heart}"/><Setter Property="Stroke" Value="{DynamicResource R2Muted}"/><Setter Property="StrokeThickness" Value="1.8"/></Style>
  <Style Selector="MenuFlyoutPresenter MenuItem"><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/></Style>
  <Style Selector="ContextMenu MenuItem"><Setter Property="Foreground" Value="{DynamicResource R2Ink}"/></Style>
  <Style Selector="StackPanel.row-actions"><Setter Property="MaxWidth" Value="0"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="Opacity" Value="0"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="{x:Static tok:DesignTokens.MotionEffectsFastDuration}" Easing="{x:Static tok:DesignTokens.MotionEffectsFastEasing}"/></Transitions></Setter></Style>
  <Style Selector="ListBoxItem:pointerover StackPanel.row-actions, ListBoxItem:focus-within StackPanel.row-actions"><Setter Property="MaxWidth" Value="Infinity"/><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Button.caption"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Button.caption PathIcon"><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="RenderTransformOrigin" Value="50%,50%"/><Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{x:Static tok:DesignTokens.MotionSpatialFastDuration}" Easing="{x:Static tok:DesignTokens.MotionSpatialFastEasing}"/></Transitions></Setter></Style>
  <Style Selector="Button.caption:pointerover PathIcon"><Setter Property="RenderTransform" Value="scale(1.12)"/></Style>
  <Style Selector="Button.caption:pressed PathIcon"><Setter Property="RenderTransform" Value="scale(0.92)"/></Style>
  <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource R2Accent}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.close:pointerover PathIcon"><Setter Property="Foreground" Value="White"/><Setter Property="RenderTransform" Value="scale(1.12)"/></Style>
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource R2Ink}"/><Setter Property="PlaceholderForeground" Value="{DynamicResource R2Muted}"/>
    <Setter Property="Background" Value="{DynamicResource R2Side}"/><Setter Property="BorderBrush" Value="{DynamicResource R2Edge}"/>
    <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="13,6"/><Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="ListBox.songs > ListBoxItem"><Setter Property="Background" Value="{DynamicResource R2RowBase}"/></Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="{x:Static tok:DesignTokens.MotionEffectsFastDuration}" Easing="{x:Static tok:DesignTokens.MotionEffectsFastEasing}"/></Transitions></Setter>
  </Style>
  <Style Selector="ListBox.songs > ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource R2RowHover}"/></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource R2Hover}"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource R2Tint}"/><Setter Property="BorderBrush" Value="{DynamicResource R2Accent}"/></Style>
  <Style Selector="Border.playlist-tile">
    <Setter Property="RenderTransform" Value="translateY(0px)"/>
    <Setter Property="BoxShadow" Value="0 8 16 0 #140F172A"/>
    <Setter Property="Transitions"><Transitions>
      <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static tok:DesignTokens.MotionSpatialFastDuration}" Easing="{x:Static tok:DesignTokens.MotionSpatialFastEasing}"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Border.playlist-tile:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    <Setter Property="BoxShadow" Value="0 12 24 0 #290F172A"/>
  </Style>
  <Style Selector="Button.card-play"><Setter Property="Opacity" Value="0"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="{x:Static tok:DesignTokens.MotionEffectsFastDuration}" Easing="{x:Static tok:DesignTokens.MotionEffectsFastEasing}"/></Transitions></Setter></Style>
  <Style Selector="Border.playlist-tile:pointerover Button.card-play"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Button.card-play:focus-visible"><Setter Property="Opacity" Value="1"/></Style>
  <StyleInclude Source="avares://HuayuanMusic.P17.Nightflight/Themes/GlassControls.axaml"/>
</Styles>
